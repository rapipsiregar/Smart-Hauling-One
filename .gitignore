# Hanya yang MUNCUL SENDIRI saat aplikasi dijalankan atau dibangun.
#
# Aturan sengaja tanpa jangkar direktori, supaya berlaku di keempat subproyek
# (core/backend, core/frontend, edge/backend, edge/frontend) tanpa ditulis
# empat kali.
#
# Selain daftar di bawah, SEMUANYA ikut ter-commit — termasuk berkas .env dan
# basis data awal — supaya checkout di mesin lain langsung bisa dijalankan
# tanpa menyiapkan apa pun secara manual.

# --- Lingkungan Python yang dibuat `uv sync` ---------------------------------
.venv/
.venv-*/
__pycache__/
*.py[cod]
*.egg-info/

# --- Dependensi & hasil build Node/Next.js -----------------------------------
# node_modules dipulihkan dengan `npm install` / `bun install`; .next dibuat
# ulang tiap build dan berisi lintasan absolut mesin pembuatnya.
node_modules/
.next/
.next-*/
out/
next-env.d.ts
tsconfig.tsbuildinfo

# --- Cache alat uji ----------------------------------------------------------
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage

# --- Keluaran runtime --------------------------------------------------------
# Dibuat perangkat/pusat saat berjalan: cuplikan foto lintasan, rekaman segmen,
# video beranotasi, dan salinan cadangan basis data. Semuanya tumbuh tanpa batas
# dan tidak diperlukan untuk menjalankan sistem di mesin baru.
snapshots/
video/
# Nama direktori tanpa garis miring di tengah, supaya cocok di kedalaman mana
# pun. Ditulis "data/backups/" pola itu ter-anchor ke lokasi .gitignore dan
# luput di keempat subproyek.
backups/
04-annotated/
*.log

# Berkas pendamping SQLite. Ikut ter-commit justru berbahaya: memulihkan basis
# data bersama -wal lama dari mesin lain dapat merusaknya.
*.db-wal
*.db-shm

# --- Sistem operasi & editor -------------------------------------------------
.DS_Store
Thumbs.db
.idea/
.vscode/

# --- Folder data root untuk data unduhan/generasi ---
/data/

