# Pengaturan seluruh sistem — dibaca docker-compose.yml di root.
#
# Berkas ini SENGAJA ikut ter-commit supaya checkout di mesin lain langsung
# bisa dijalankan dengan `make up` tanpa menyiapkan apa pun.

# --- Port ---------------------------------------------------------------------
# Ubah bila port ini sudah dipakai proses lain di mesin Anda.
CORE_API_PORT=8000
CORE_UI_PORT=3000
EDGE_API_PORT=8100
EDGE_UI_PORT=3100

# --- Pusat --------------------------------------------------------------------
# Alamat pusat SEBAGAIMANA DIHUBUNGI PERANGKAT POS. Ditampilkan di Konsol Pusat
# (Kamera Per Pos) untuk disalin ke berkas .env perangkat saat pemasangan.
# Ganti dengan alamat IP mesin ini bila perangkat pos berada di komputer lain.
SMART_GATE_CORE_PUBLIC_URL=http://localhost:8000

# Pencadangan basis data berjalan sendiri tiap enam jam. Isi "true" hanya bila
# pencadangan diurus di luar aplikasi (basis data terkelola, snapshot volume).
SMART_GATE_DISABLE_BACKUP=false

# --- Perangkat pos gerbang ----------------------------------------------------
# Dipakai pasangan edge di docker-compose.yml root. Untuk memasang pos di mesin
# terpisah, gunakan edge/docker-compose.yml beserta edge/.env.
EDGE_CAMERA_CODE=CAM-GATE-A
EDGE_API_KEY=dev-api-key
EDGE_RTSP_URL=rtsp://192.168.1.50:554/stream1

# Deteksi butuh kamera, GPU, dan berkas model — dimatikan dulu untuk
# pengembangan. API, replika master, dan pencocokan tetap berfungsi tanpanya.
EDGE_RUN_AGENT=false

# Alamat reset pos yang ikut dibersihkan tombol reset di pusat, dipisah koma.
DEV_GATE_RESET_URLS=http://edge-backend:8100/api/crossings-reset
