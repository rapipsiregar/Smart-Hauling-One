# Pengaturan perangkat pos gerbang — dipakai oleh edge/docker-compose.yml.
#
# Berkas ini SENGAJA ikut ter-commit supaya checkout di mesin lain langsung
# jalan tanpa menyiapkan apa pun. Nilai di bawah adalah nilai pengembangan.
#
# Sebelum dipakai di lapangan, ganti dua hal:
#   1. SMART_GATE_API_KEY  -> terbitkan yang baru di Konsol Pusat
#                             (Kamera Per Pos -> pos ini -> Terbitkan Ulang Kunci)
#   2. SMART_GATE_RTSP_URL -> alamat kamera sungguhan di pos tersebut

# Kode pos ini. Harus sama persis dengan yang terdaftar di Konsol Pusat.
SMART_GATE_CAMERA_CODE=CAM-GATE-A

# Alamat server pusat yang dihubungi perangkat.
# Di dalam docker-compose satu mesin: http://core-backend:8000
SMART_GATE_INDUK_URL=http://core-backend:8000

# Kunci akses perangkat. Kunci pengembangan — terbitkan yang baru untuk lapangan.
SMART_GATE_API_KEY=dev-api-key

# Sumber video. RTSP di lapangan; berkas video lokal juga bisa untuk pengujian.
SMART_GATE_RTSP_URL=rtsp://192.168.1.50:554/stream1

# Arah gerak truk yang berarti MASUK, dilihat di layar kamera ini.
#   ltr = truk masuk bergerak kiri ke kanan
#   rtl = truk masuk bergerak kanan ke kiri
#
# Ini geometri pemasangan kamera. Salah setel berarti SETIAP lintasan tercatat
# terbalik, tanpa pesan galat. Rekaman contoh di video-sources/ adalah pos rtl.
# Setelah perangkat terhubung, nilai ini diambil alih oleh Konsol Pusat.
SMART_GATE_INBOUND_AXIS=rtl

# Deteksi butuh kamera, GPU, dan berkas model. Dimatikan dulu supaya perangkat
# bisa dipasang dan diperiksa sambungannya lebih dahulu.
SMART_GATE_RUN_AGENT=false

# Mesin pembaca nomor lambung.
SMART_GATE_OCR_BACKEND=ppocrv6-tiny

# Rekaman contoh yang ikut ditawarkan di tombol Jalankan Uji, di samping rekaman
# milik pos ini sendiri. Read-only dan tidak pernah digabung ke rekaman pos:
# mencampurnya akan menaruh video tak berkaitan ke dalam folder yang diperlakukan
# pos sebagai catatannya sendiri. Bila ada nama yang sama, rekaman pos yang menang.
SMART_GATE_SAMPLE_CLIP_DIR=/srv/sample-videos

# Port yang dipakai perangkat ini.
EDGE_API_PORT=8100
EDGE_UI_PORT=3100
