# Copy to .env on the device during provisioning (docs/edge-system/SRS.md §7.3 step 3).
SMART_GATE_INDUK_URL=https://induk.smartgate.example
SMART_GATE_API_KEY=paste-the-plaintext-key-from-provision-device-here
SMART_GATE_CAMERA_CODE=GATE-A

# Camera source. RTSP in production; a local video file works for testing --
# cv2.VideoCapture accepts either, so the agent runs unmodified against a clip.
SMART_GATE_RTSP_URL=rtsp://192.168.1.50:554/stream1

# Local storage
SMART_GATE_OUTBOX_DB=/var/lib/smart-gate/outbox.db
SMART_GATE_SNAPSHOT_DIR=/var/lib/smart-gate/snapshots
SMART_GATE_VIDEO_DIR=/var/lib/smart-gate/video

# Model weights (TensorRT-exported .engine in production; .pt works for testing)
SMART_GATE_MODEL_PATH=/opt/smart-gate/pak-shomad-v2.engine

# Which OCR engine reads the crops YOLO hands over (agent/ocr_backends.py).
#
#   ppocrv6-tiny   default. 4.5 MB of weights, ~15 ms per crop on CPU.
#   ppocrv6-small  same family, a step up in size and accuracy.
#   ppocrv6-medium likewise.
#   paddleocr-vl   PaddleOCR-VL 0.9B. 1.8 GB, ~0.5 s per crop on a desktop GPU.
#                  Reads degraded plates the tiny model misses; needs the
#                  `inference-vl` extra installed. Choose this only for a gate
#                  whose plates actually defeat the small model -- on the sample
#                  footage that was one clip in fifteen.
#
# Changing this needs a restart: it loads a different model.
SMART_GATE_OCR_BACKEND=ppocrv6-tiny

# Recorded clips the console can replay through the real detection chain.
SMART_GATE_CLIP_DIR=/opt/smart-gate/video-sources

# Which way an ARRIVING truck travels across this camera's frame.
#
#   ltr  arriving trucks move left -> right (default)
#   rtl  arriving trucks move right -> left
#
# Mounting geometry, so it is set once per device at provisioning and never
# retuned. Get it wrong and the gate is not merely imprecise -- it records every
# crossing as its exact opposite, which puts trucks "inside" the pit after they
# have left and silently corrupts ritase pairing. The reference footage in
# video-sources/ is an rtl gate; verify against a clip whose name says In or Out
# before trusting a new install.
SMART_GATE_INBOUND_AXIS=ltr
